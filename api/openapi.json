{
  "openapi": "3.0.3",
  "info": {
    "title": "Diet Optimization API",
    "version": "1.0.0",
    "description": "REST API for AI nutrition optimization (proxy to FastAPI)."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "http://localhost:3000"
        }
      }
    }
  ],
  "paths": {
    "/api/health": {
      "get": {
        "summary": "Health check",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/optimizes": {
      "post": {
        "summary": "Optimize nutrition",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/OptimizeRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OptimizeResponse"
                }
              }
            }
          },
          "400": {
            "description": "Validation error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/StandardResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "OptimizeRequest": {
        "type": "object",
        "required": ["budget_maksimal", "target_kalori", "berat_badan"],
        "properties": {
          "budget_maksimal": {
            "type": "integer",
            "example": 15000
          },
          "target_kalori": {
            "type": "integer",
            "example": 2200
          },
          "berat_badan": {
            "type": "number",
            "format": "float",
            "example": 65.0
          },
          "protein": {
            "type": "number",
            "format": "float",
            "default": 0,
            "example": 0
          },
          "lemak": {
            "type": "number",
            "format": "float",
            "default": 0,
            "example": 0
          },
          "karbo": {
            "type": "number",
            "format": "float",
            "default": 0,
            "example": 0
          }
        }
      },
      "StandardResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "OK"
          },
          "data": {
            "type": "object"
          }
        }
      },
      "OptimizeResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "success"
          },
          "message": {
            "type": "string",
            "example": "Request berhasil diproses."
          },
          "data": {
            "type": "object",
            "properties": {
              "parameter_pencarian": {
                "type": "object",
                "properties": {
                  "budget": {
                    "type": "integer",
                    "example": 15000
                  },
                  "kalori": {
                    "type": "integer",
                    "example": 600
                  }
                }
              },
              "rekomendasi_menu": {
                "type": "array",
                "items": {
                  "type": "object"
                }
              },
              "ringkasan": {
                "type": "object",
                "properties": {
                  "skor_nutrisi_prediksi": {
                    "type": "number",
                    "format": "float",
                    "example": 0.85
                  },
                  "catatan_ai": {
                    "type": "string",
                    "example": "Budget Anda cukup untuk menu seimbang dengan protein tinggi."
                  },
                  "menu_baru": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string",
                          "example": "Nasi Ayam Tempe"
                        },
                        "cal": {
                          "type": "integer",
                          "example": 450
                        },
                        "protein": {
                          "type": "integer",
                          "example": 25
                        },
                        "carbs": {
                          "type": "integer",
                          "example": 50
                        },
                        "fat": {
                          "type": "integer",
                          "example": 12
                        },
                        "description": {
                          "type": "string",
                          "example": "Menu seimbang dengan protein tinggi"
                        },
                        "tags": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          },
                          "example": ["Lokal", "Tinggi Protein"]
                        },
                        "time": {
                          "type": "string",
                          "example": "Makan Siang"
                        },
                        "img": {
                          "type": "string",
                          "example": "AI"
                        },
                        "score": {
                          "type": "integer",
                          "example": 95
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
