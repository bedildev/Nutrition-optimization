# ============================================================
# Diet-Optimization-AI - Environment Variables
# Salin file ini menjadi .env dan isi nilainya.
# Jangan pernah commit file .env ke repository!
# ============================================================

# --- Supabase ---
# URL Project Supabase (shared antara backend & frontend)
SUPABASE_URL=https://your-project-id.supabase.co

# Backend (private) - Service Role Key (JANGAN expose ke frontend!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage bucket name (buat bucket ini di Supabase Storage)
SUPABASE_BUCKET_NAME=nutriai-storage

# Frontend (public) - Anon Key (aman untuk diexpose di browser)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI / Model ---
# Gemini API Key (dari https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your-gemini-api-key-here

# URL FastAPI Model (Hugging Face Space atau server lain)
# Contoh: https://username-space-name.hf.space
FASTAPI_BASE_URL=https://your-hf-space.hf.space

# --- Frontend Config ---
# URL Backend API (untuk development lokal)
VITE_API_BASE_URL=http://localhost:4000
# Set true untuk gunakan backend Express, false untuk mode lokal tanpa backend
VITE_USE_BACKEND=true

# --- Vercel Deployment ---
# Saat deploy ke Vercel, set VITE_API_BASE_URL ke URL Vercel kamu:
# VITE_API_BASE_URL=https://your-project.vercel.app
