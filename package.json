{
  "name": "diet-optimization-deploy",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "concurrently \"npm run dev:model\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:model": "cd model && python -m uvicorn main:app --reload --host 0.0.0.0 --port 8000",
    "dev:backend": "cd backend && npm run dev",
    "dev:frontend": "cd frontend && npm run dev"
  },
  "dependencies": {
    "axios": "^1.16.1",
    "joi": "^17.13.3"
  },
  "devDependencies": {
    "concurrently": "^9.0.2"
  }
}
