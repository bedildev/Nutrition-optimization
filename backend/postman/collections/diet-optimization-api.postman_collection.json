      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const unique = Date.now();",
              "pm.environment.set(\"demoRegisterEmail\", `nutriai.dev${unique}@outlook.com`);"
