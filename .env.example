# --- Supabase ---
# URL Project Supabase
SUPABASE_URL=https://your-project-id.supabase.co

# Backend (private) - Service Role Key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Storage bucket name
SUPABASE_BUCKET_NAME=nutriai-storage

# Frontend (public) - Anon Key 
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# --- AI / Model ---
# Gemini API Key 
GEMINI_API_KEY=your-gemini-api-key-here

# URL FastAPI Model (Hugging Face Space atau server lain)
FASTAPI_BASE_URL=https://your-hf-space.hf.space

# --- Frontend Config ---
# URL Backend API 
VITE_API_BASE_URL=http://localhost:4000
# Set true untuk gunakan backend Express, false untuk mode lokal tanpa backend
VITE_USE_BACKEND=true

# --- Vercel Deployment ---
# VITE_API_BASE_URL=https://your-project.vercel.app
